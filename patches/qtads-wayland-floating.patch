+#if defined(Q_OS_UNIX) && !defined(Q_OS_MACOS)
+//============================================================================
+void FloatingDockContainerPrivate::updateWaylandTransientParent()
+{
+	// The floating widget has no parent widget on Wayland (see the
+	// constructor), so make the dock manager window its transient parent.
+	// The compositor then keeps it above that window like the floating
+	// widgets on the other platforms, instead of hiding it behind the main
+	// window as soon as the user clicks into the main window.
+	QWindow* Window = _this->windowHandle();
+	QWidget* ParentWidget = DockManager ? DockManager->window() : nullptr;
+	if (!Window || !ParentWidget || ParentWidget == _this)
+	{
+		return;
+	}
+
+	QWindow* ParentWindow = ParentWidget->windowHandle();
+	if (ParentWindow && ParentWindow->isExposed())
+	{
+		// The show event arrives before the window is mapped, so the parent
+		// is part of the initial xdg_toplevel state
+		Window->setTransientParent(ParentWindow);
+		return;
+	}
+
+	// A floating widget restored before the dock manager window is shown
+	// would be mapped before its parent, and the compositor ignores an
+	// unmapped parent. Map it again once the parent window is mapped.
+	if (TransientParentWatcher)
+	{
+		return;
+	}
+	QPointer<CFloatingDockContainer> Floating(_this);
+	TransientParentWatcher = new CWaylandFirstPaintWatcher(ParentWidget, _this, [Floating]()
+	{
+		if (Floating && Floating->isVisible())
+		{
+			Floating->hide();
+			Floating->show();
+		}
+	});
+}
+#endif
