+/**
+ * Wayland: floating dock containers are frameless, so that the dock area
+ * title bar is the only title bar. Dragging a compositor drawn window
+ * decoration only moves the window - the client is never told about the
+ * move - so a decorated floating widget could not be docked by dragging it
+ * by its title bar. Without a decoration the compositor provides no resize
+ * border either. This filter turns a thin margin around the dock container
+ * into one: it shows resize cursors, starts a compositor driven resize on a
+ * press and paints an outline that separates the window from the windows
+ * below it.
+ */
+class CWaylandFrameResizer : public QObject
+{
+public:
+	static constexpr int BorderWidth = 5;
+
+	CWaylandFrameResizer(QWidget* Window, QWidget* Frame)
+		: QObject(Window), m_Window(Window), m_Frame(Frame)
+	{
+		Frame->setContentsMargins(BorderWidth, BorderWidth, BorderWidth, BorderWidth);
+		Frame->setMouseTracking(true);
+		Frame->installEventFilter(this);
+	}
+
+	bool eventFilter(QObject* Object, QEvent* Event) override
+	{
+		if (Object != m_Frame)
+		{
+			return false;
+		}
+
+		switch (Event->type())
+		{
+		case QEvent::MouseMove:
+			setCursorFor(edgesAt(static_cast<QMouseEvent*>(Event)->position().toPoint()));
+			break;
+
+		case QEvent::Leave:
+			m_Frame->unsetCursor();
+			break;
+
+		case QEvent::MouseButtonPress:
+		{
+			auto MouseEvent = static_cast<QMouseEvent*>(Event);
+			const Qt::Edges Edges = edgesAt(MouseEvent->position().toPoint());
+			if (MouseEvent->button() == Qt::LeftButton && Edges
+			 && m_Window->windowHandle()
+			 && m_Window->windowHandle()->startSystemResize(Edges))
+			{
+				return true;
+			}
+			break;
+		}
+
+		case QEvent::Paint:
+		{
+			// The dock container paints nothing outside of its children, so
+			// the outline can be painted before it gets the event. No palette
+			// role contrasts with the window color in both light and dark
+			// themes, so the outline blends the text color into it.
+			const QColor Window = m_Frame->palette().color(QPalette::Window);
+			const QColor Text = m_Frame->palette().color(QPalette::WindowText);
+			const auto Blend = [](float a, float b) { return a + (b - a) * 0.3f; };
+			QPainter Painter(m_Frame);
+			Painter.setPen(QColor::fromRgbF(Blend(Window.redF(), Text.redF()),
+				Blend(Window.greenF(), Text.greenF()), Blend(Window.blueF(), Text.blueF())));
+			Painter.drawRect(m_Frame->rect().adjusted(0, 0, -1, -1));
+			break;
+		}
+
+		default:
+			break;
+		}
+		return false;
+	}
+
+private:
+	Qt::Edges edgesAt(const QPoint& Pos) const
+	{
+		Qt::Edges Edges;
+		if (m_Window->isMaximized() || m_Window->isFullScreen())
+		{
+			return Edges;
+		}
+
+		// The corners are larger than the border, so that they are easy to hit
+		const int Corner = 4 * BorderWidth;
+		const QRect r = m_Frame->rect();
+		const bool Left = Pos.x() < BorderWidth;
+		const bool Right = Pos.x() >= r.width() - BorderWidth;
+		const bool Top = Pos.y() < BorderWidth;
+		const bool Bottom = Pos.y() >= r.height() - BorderWidth;
+		if (!Left && !Right && !Top && !Bottom)
+		{
+			return Edges;
+		}
+
+		Edges.setFlag(Qt::LeftEdge, Pos.x() < Corner);
+		Edges.setFlag(Qt::RightEdge, Pos.x() >= r.width() - Corner);
+		Edges.setFlag(Qt::TopEdge, Pos.y() < Corner);
+		Edges.setFlag(Qt::BottomEdge, Pos.y() >= r.height() - Corner);
+		return Edges;
+	}
+
+	void setCursorFor(Qt::Edges Edges)
+	{
+		if (!Edges)
+		{
+			m_Frame->unsetCursor();
+		}
+		else if (Edges == (Qt::TopEdge | Qt::LeftEdge) || Edges == (Qt::BottomEdge | Qt::RightEdge))
+		{
+			m_Frame->setCursor(Qt::SizeFDiagCursor);
+		}
+		else if (Edges == (Qt::TopEdge | Qt::RightEdge) || Edges == (Qt::BottomEdge | Qt::LeftEdge))
+		{
+			m_Frame->setCursor(Qt::SizeBDiagCursor);
+		}
+		else if (Edges & (Qt::LeftEdge | Qt::RightEdge))
+		{
+			m_Frame->setCursor(Qt::SizeHorCursor);
+		}
+		else
+		{
+			m_Frame->setCursor(Qt::SizeVerCursor);
+		}
+	}
+
+	QWidget* m_Window;
+	QWidget* m_Frame;
+};
+
+
+/**
+ * Wayland: calls the given function once, after the first paint of the
+ * watched widget, that is, when its window is mapped
+ */
+class CWaylandFirstPaintWatcher : public QObject
+{
+public:
+	CWaylandFirstPaintWatcher(QWidget* Watched, QObject* Parent, std::function<void()> Callback)
+		: QObject(Parent), m_Callback(std::move(Callback))
+	{
+		Watched->installEventFilter(this);
+	}
+
+	bool eventFilter(QObject* Object, QEvent* Event) override
+	{
+		if (Event->type() == QEvent::Paint)
+		{
+			Object->removeEventFilter(this);
+			// Leave the paint event before the callback changes windows
+			QMetaObject::invokeMethod(this, [this]()
+			{
+				m_Callback();
+				deleteLater();
+			}, Qt::QueuedConnection);
+		}
+		return false;
+	}
+
+private:
+	std::function<void()> m_Callback;
+};
+#endif
